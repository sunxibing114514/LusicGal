<?xml version="1.0" encoding="utf-8"?>
<!-- 手工 APK 管线合并清单（app 壳 + lusicgal_engines 插件声明）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lusicgal.lusicgal">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="LusicGal"
        android:icon="@mipmap/ic_launcher"
        android:hasFragileUserData="false"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true">

        <!-- Flutter 入口（embedding 提供；kernel_blob.bin = 引导内核）。 -->
        <activity
            android:name="io.flutter.embedding.android.FlutterActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 插件：Web 引擎运行页（Tyrano / RPG MV / MZ）。 -->
        <activity
            android:name="com.lusicgal.engines.web.WebGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
