<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Web 引擎运行页（Tyrano / RPG MV / MZ；本地 HTTP + hook 注入跑法）。 -->
    <application>
        <activity
            android:name="com.lusicgal.engines.web.WebGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 只读文件提供器（FileProvider 同款形态：exported=false +
             grantUriPermissions=true；跨应用经 FLAG_GRANT_READ 临时授权
             访问沙盒内游戏文件 —— PPSSPP 等独立 UID 场景）。 -->
        <provider
            android:name="com.lusicgal.engines.LusicgalGamesProvider"
            android:authorities="com.lusicgal.games"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
